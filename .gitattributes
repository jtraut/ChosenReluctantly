# Normalize line endings: LF in the repo; Godot text resources are line-based and merge better as LF
* text=auto
*.md text eol=lf
*.gd text eol=lf
*.json text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.cfg text eol=lf
*.godot text eol=lf
*.ps1 text eol=lf
*.uid text eol=lf
*.import text eol=lf
*.gdignore text eol=lf
.gdignore text eol=lf

# Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.glb binary
*.gltf binary
*.exe binary
*.dll binary
*.zip binary
